filters:
  and:
    - file.inFolder("Work")
    - type == "plan" || type == "issue"
    - status != "done"
    - status != "superseded"
    - status != "archived"
views:
  - type: table
    name: Draft Plans
    filters:
      and:
        - type == "plan"
        - status == "draft"
    order:
      - file.name
      - domains
      - status
      - updated
  - type: table
    name: Executable Plans
    filters:
      and:
        - type == "plan"
        - status == "ready" || status == "in-progress"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - domains
      - status
      - updated
  - type: table
    name: Open Issues
    filters:
      and:
        - type == "issue"
    groupBy:
      property: priority
      direction: ASC
    order:
      - file.name
      - domains
      - status
      - priority
      - updated
  - type: table
    name: All Active Work
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - domains
      - status
      - priority
      - updated
