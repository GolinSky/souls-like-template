filters:
  and:
    - file.inFolder("Work")
    - type == "plan" || type == "issue"
views:
  - type: table
    name: Active Work
    filters:
      and:
        - status != "done"
        - status != "superseded"
        - status != "archived"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - domains
      - status
      - priority
      - updated
  - type: table
    name: Completed Work
    filters:
      or:
        - status == "done"
        - status == "superseded"
    order:
      - file.name
      - type
      - domains
      - status
      - updated
