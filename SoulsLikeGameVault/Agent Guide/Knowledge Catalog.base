filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("Templates")'
views:
  - type: table
    name: Needs Review
    filters:
      or:
        - status == "needs-review"
        - status == "draft"
        - status == "proposed"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - domains
      - status
      - authority
      - verified
  - type: table
    name: Current Knowledge
    filters:
      or:
        - status == "current"
        - status == "ready"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - domains
      - authority
      - verified
  - type: table
    name: Archive and History
    filters:
      or:
        - status == "done"
        - status == "superseded"
        - status == "archived"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - domains
      - updated
